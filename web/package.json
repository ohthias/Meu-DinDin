{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "wasm": "asc wasm/motor.ts --outFile src/wasm/motor.wasm --bindings raw --optimizeLevel 3 --shrinkLevel 1 --runtime incremental --noAssert",
    "test": "vitest run",
    "gerar:api": "npx -y -p typescript@5 -p openapi-typescript@7 openapi-typescript ../api/openapi.json -o src/lib/api-analise.gen.ts",
    "gerar:api:vivo": "npx -y -p typescript@5 -p openapi-typescript@7 openapi-typescript ${VITE_ANALISE_API_URL:-http://localhost:5080}/swagger/v1/swagger.json -o src/lib/api-analise.gen.ts"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.67.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pluggy-connect": "^2.12.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "assemblyscript": "^0.28.20",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}

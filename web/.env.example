# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Sem essas variáveis o app roda em modo demonstração.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Mostra o banco de testes "Pluggy Bank" no widget de conexão
VITE_OPEN_FINANCE_SANDBOX=true
# Opcional: API de análise em C# (api/MeuDinDin.Api). Sem ela, o app calcula localmente
# e usa indicadores de referência em vez dos dados do Banco Central.
VITE_ANALISE_API_URL=http://localhost:5080
